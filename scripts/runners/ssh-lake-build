#!/usr/bin/env python3
"""Stream one prepared tree to a preprovisioned disposable SSH worker and return Lake's exit status."""
import os
from pathlib import Path
import shlex
import subprocess
import sys


def main():
    host = os.environ.get("VL_BUILD_HOST")
    if not host or len(sys.argv) < 3:
        print("Set VL_BUILD_HOST to a disposable SSH worker and supply DIR TARGET...", file=sys.stderr)
        return 125
    source, *targets = sys.argv[1:]
    build = Path(__file__).with_name("lake-build").read_text()
    exact = "VL_TRIAL_EXACT_MODULES=1 " if os.environ.get("VL_TRIAL_EXACT_MODULES") == "1" else ""
    remote = (
        'work=$(mktemp -d) || exit 125\n'
        'trap \'rm -rf -- "$work"\' EXIT\n'
        'tar -xzf - -C "$work" || exit 125\n'
        f'{exact}sh -c {shlex.quote(build)} lake-build "$work" {shlex.join(targets)}'
    )
    config = os.environ.get("VL_BUILD_SSH_CONFIG")
    ssh = ["ssh", "-T", "-o", "BatchMode=yes"]
    if config:
        ssh.extend(["-F", config])
    with subprocess.Popen(["tar", "-C", source, "--exclude=./.git", "-czf", "-", "."],
                          stdout=subprocess.PIPE) as archive:
        try:
            result = subprocess.run([*ssh, "--", host, remote],
                                    stdin=archive.stdout, check=False)
        finally:
            archive.stdout.close()
        if archive.wait() or result.returncode >= 126 or result.returncode < 0:
            return 125
        return result.returncode


if __name__ == "__main__":
    try:
        sys.exit(main())
    except OSError as exc:
        print(exc, file=sys.stderr)
        sys.exit(125)
